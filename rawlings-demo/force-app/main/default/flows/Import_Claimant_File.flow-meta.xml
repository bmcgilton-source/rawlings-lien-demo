<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>

    <actionCalls>
        <name>Import_File</name>
        <label>Import File</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>ClaimantFileImportInvocable</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Screen_Results</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Screen_Error</targetReference>
        </faultConnector>
        <inputParameters>
            <name>settlementId</name>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>contentDocumentId</name>
            <value>
                <elementReference>First_Content_Document_Id</elementReference>
            </value>
        </inputParameters>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>

    <environments>Default</environments>

    <interviewLabel>Import Claimant File {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Import Claimant File</label>

    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>

    <screens>
        <name>Screen_Error</name>
        <label>Something Went Wrong</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Error_Text</name>
            <fieldText>&lt;p&gt;The file could not be imported: {!$Flow.FaultMessage}&lt;/p&gt;&lt;p&gt;Close this window and try again, or use the &lt;strong&gt;Import Claimants&lt;/strong&gt; action as a fallback.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Upload</name>
        <label>Upload Claimant File</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Import_File</targetReference>
        </connector>
        <fields>
            <name>Upload_Claimant_File</name>
            <extensionName>c:claimantFileUpload</extensionName>
            <fieldType>ComponentInstance</fieldType>
            <inputParameters>
                <name>recordId</name>
                <value>
                    <elementReference>recordId</elementReference>
                </value>
            </inputParameters>
            <outputParameters>
                <assignToReference>First_Content_Document_Id</assignToReference>
                <name>contentDocumentId</name>
            </outputParameters>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Results</name>
        <label>Import Results</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Results_Text_Success</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;Import complete&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;{!Import_File.rowsReceived} rows received&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Liens created or updated&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;{!Import_File.createdCount} liens created&lt;/li&gt;&lt;li&gt;{!Import_File.updatedCount} liens updated&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;strong&gt;Evaluation outcome&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;{!Import_File.automatedCount} processing automatically&lt;/li&gt;&lt;li&gt;{!Import_File.escalatedCount} routed for coverage review&lt;/li&gt;&lt;/ul&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>Import_File.rejectedCount</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <numberValue>0.0</numberValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>Results_Text_With_Rejections</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;Import complete with data-quality issues&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;{!Import_File.rowsReceived} rows received&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Liens created or updated&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;{!Import_File.createdCount} liens created&lt;/li&gt;&lt;li&gt;{!Import_File.updatedCount} liens updated&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;strong&gt;Rejected rows&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;{!Import_File.rejectedCount} rows rejected&lt;/li&gt;&lt;li&gt;Rejection file: {!Import_File.rejectionFilename}&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;strong&gt;Evaluation outcome&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;{!Import_File.automatedCount} processing automatically&lt;/li&gt;&lt;li&gt;{!Import_File.escalatedCount} routed for coverage review&lt;/li&gt;&lt;/ul&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>Import_File.rejectedCount</leftValueReference>
                    <operator>GreaterThan</operator>
                    <rightValue>
                        <numberValue>0.0</numberValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>

    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Screen_Upload</targetReference>
        </connector>
    </start>
    <status>Active</status>

    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>First_Content_Document_Id</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>

</Flow>
